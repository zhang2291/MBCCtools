{
  "name": "MBCCtools",
  "title": "MBCCtools",
  "interface_version": 2,
  "icon": "resource/base/image/logo.jpg",
  "version": "v1.4.3-local.1",
  "mirrorchyan_rid": "MBCCtools",
  "mirrorchyan_multiplatform": true,
  "url": "https://github.com/zhang2291/MBCCtools",
  "controller": [
    {
      "name": "安卓端",
      "type": "Adb"
    }
  ],
  "resource": [
    {
      "name": "官服",
      "path": [
        "resource/base"
      ]
    },
    {
      "name": "B服",
      "path": [
        "resource/base",
        "resource/bilibili"
      ]
    },
    {
      "name": "国际服",
      "path": [
        "resource/base",
        "resource/global"
      ]
    }
  ],
  "task": [
    {
      "name": "进入游戏",
      "entry": "启动",
      "doc": "[color:orange]请注意[/color]\n有可能失败，建议手动进入主菜单后再运行",
      "default_check": false,
      "resource": [
        "官服",
        "B服",
        "国际服"
      ]
    },
    {
      "name": "退出游戏",
      "entry": "退出游戏",
      "default_check": false,
      "resource": [
        "官服",
        "B服",
        "国际服"
      ]
    },
    {
      "name": "秘盟捐赠",
      "entry": "密盟",
      "doc": "默认捐赠[b]狄斯币[/b]",
      "default_check": false,
      "resource": [
        "官服",
        "B服",
        "国际服"
      ]
    },
    {
      "name": "好友点数",
      "entry": "友情点",
      "default_check": false,
      "resource": [
        "官服",
        "B服",
        "国际服"
      ]
    },
    {
      "name": "监管奖励",
      "entry": "监管",
      "default_check": false,
      "resource": [
        "官服",
        "B服",
        "国际服"
      ]
    },
    {
      "name": "采购办免费礼包",
      "entry": "采购办",
      "default_check": false,
      "resource": [
        "官服",
        "B服",
        "国际服"
      ]
    },
    {
      "name": "一键派遣",
      "entry": "派遣",
      "option": [
        "派遣区域"
      ],
      "doc": "[color:orange]不会[/color]帮你领取声望奖励哦",
      "default_check": false,
      "resource": [
        "官服",
        "B服",
        "国际服"
      ]
    },
    {
      "name": "领取体力",
      "entry": "体力",
      "default_check": false,
      "resource": [
        "官服",
        "B服",
        "国际服"
      ]
    },
    {
      "name": "邮箱领取",
      "entry": "邮箱",
      "default_check": false,
      "resource": [
        "官服",
        "B服",
        "国际服"
      ]
    },
    {
      "name": "扫荡浊暗之阱",
      "entry": "浊暗之阱",
      "doc": "默认扫荡[b]乐园幻境[/b]",
      "default_check": false,
      "resource": [
        "官服",
        "B服",
        "国际服"
      ]
    },
    {
      "name": "扫荡记忆风暴",
      "entry": "记忆风暴",
      "option": [
        "畸点选择"
      ],
      "doc": "本任务会自动扫荡正在开放的畸点最高难度三次",
      "default_check": false,
      "resource": [
        "官服",
        "B服",
        "国际服"
      ]
    },
    {
      "name": "每日体力用途",
      "entry": "每日体力用途",
      "option": [
        "作战区域",
        "材料选择",
        "关卡未开放备选"
      ],
      "doc": "\n选择[b]「刷取材料」[/b]时需要同时选择材料\n\n选择[b]「关卡未开放备选」[/b]后，当日关卡未开放时会自动刷取备选关卡",
      "default_check": false,
      "resource": [
        "官服",
        "B服",
        "国际服"
      ]
    },
    {
      "name": "每日/密令奖励",
      "entry": "密令",
      "option": [
        "等级奖励"
      ],
      "default_check": false,
      "resource": [
        "官服",
        "B服",
        "国际服"
      ]
    },
    {
      "name": "破碎防线",
      "entry": "破碎防线",
      "doc": "只支持自动领奖，不战斗",
      "default_check": false,
      "resource": [
        "官服",
        "B服",
        "国际服"
      ]
    },
    {
      "name": "夜莺助手快捷任务跳转",
      "entry": "夜莺助手快捷任务跳转",
      "option": [
        "派遣区域",
        "畸点选择"
      ],
      "doc": "快捷任务会复用一键派遣与记忆风暴的配置；派遣区域和畸点选择在这里统一设置。",
      "default_check": false,
      "resource": [
        "官服"
      ]
    }
  ],
  "preset": [
    {
      "name": "自动任务测试",
      "description": "包含当前全部自动任务；默认开启进入游戏和夜莺助手，其他任务可在任务页逐项启用。",
      "task": [
        {
          "name": "进入游戏",
          "enabled": true
        },
        {
          "name": "退出游戏",
          "enabled": false
        },
        {
          "name": "秘盟捐赠",
          "enabled": false
        },
        {
          "name": "好友点数",
          "enabled": false
        },
        {
          "name": "监管奖励",
          "enabled": false
        },
        {
          "name": "采购办免费礼包",
          "enabled": false
        },
        {
          "name": "一键派遣",
          "enabled": false
        },
        {
          "name": "领取体力",
          "enabled": false
        },
        {
          "name": "邮箱领取",
          "enabled": false
        },
        {
          "name": "扫荡浊暗之阱",
          "enabled": false
        },
        {
          "name": "扫荡记忆风暴",
          "enabled": false
        },
        {
          "name": "每日体力用途",
          "enabled": false
        },
        {
          "name": "每日/密令奖励",
          "enabled": false
        },
        {
          "name": "破碎防线",
          "enabled": false
        },
        {
          "name": "夜莺助手快捷任务跳转",
          "enabled": true
        }
      ]
    }
  ],
  "option": {
